# Copy to .env.local and fill in. Never commit real values.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=
# Optional backup reader. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Database: Neon Postgres (Vercel → Storage → Neon). Tables are created automatically.
# Without it, data goes to .data/db.json locally.
DATABASE_URL=
# Optional: private photo storage in Vercel Blob. Without it, photos are kept privately in the database.
BLOB_READ_WRITE_TOKEN=
