# Copy to .env.local and fill in. Never commit real values.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=
# Optional backup reader. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: without these, data goes to .data/db.json locally
# Project base URL only, e.g. https://abcd.supabase.co (no /rest/v1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
